{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-02-19",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"rate_limiting": [
		{
			"name": "RATE_LIMITER",
			"threshold": 10,
			"period": 60,
			"action": "block"
		}
	],
	"main": "./worker.ts"
}
